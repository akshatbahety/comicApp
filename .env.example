# Copy to .env.local and fill in. Never commit .env.local.

# fal.ai API key (server-only) — https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic API key (server-only) for Claude script writing — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the script model (default claude-opus-5-5)
# ANTHROPIC_MODEL=

# Optional: set to "mock" to use offline placeholder art instead of fal
# NEXT_PUBLIC_AI_MODE=mock

# Supabase (F-010) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-only, F-019) — Project Settings > API Keys > Secret keys.
# Lets the Dodo webhook write subscriptions. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Dodo Payments (F-019) — https://app.dodopayments.com > Developer > API Keys / Webhooks
# Use test_mode keys + a test-mode product while developing; live_mode in production.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# The $10/month "Panelforge Monthly" product. Live: pdt_0NsVkQ6LJndbO61vaCoc6
DODO_PRODUCT_ID=
